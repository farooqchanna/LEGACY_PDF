<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme: AppCompat Light (Guarantees compatibility with AppCompatActivity on API 14+) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="actionBarStyle">@style/AppActionBar</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
    </style>

    <!-- Custom Action Bar Style -->
    <style name="AppActionBar" parent="Widget.AppCompat.Light.ActionBar">
        <item name="background">@color/action_bar_bg</item>
        <item name="android:background">@color/action_bar_bg</item>
        <item name="titleTextStyle">@style/ActionBarTitle</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Action Bar Title Text -->
    <style name="ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/action_bar_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Dark Viewer Theme (for dark mode in reader) -->
    <style name="AppTheme.DarkViewer" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="actionBarStyle">@style/DarkActionBar</item>
        <item name="android:actionBarStyle">@style/DarkActionBar</item>
    </style>

    <style name="DarkActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/dark_toolbar</item>
        <item name="android:background">@color/dark_toolbar</item>
    </style>

    <!-- Card Style for PDF items -->
    <style name="PdfCardStyle">
        <item name="android:background">@color/card_background</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <!-- Text Styles -->
    <style name="TextPrimary">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_primary</item>
    </style>

    <style name="TextSecondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>

    <style name="TextSectionHeader">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_section_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">@dimen/section_padding</item>
        <item name="android:paddingTop">@dimen/section_padding</item>
        <item name="android:paddingBottom">@dimen/section_padding_small</item>
    </style>

    <!-- Button Style -->
    <style name="FolderButton">
        <item name="android:background">@color/card_background</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_primary</item>
        <item name="android:padding">@dimen/button_padding</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <!-- Viewer Overlay Bar Style -->
    <style name="ViewerOverlayBar">
        <item name="android:background">@color/semi_transparent_black</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- Dialog Theme -->
    <style name="AppDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@color/card_background</item>
    </style>

</resources>

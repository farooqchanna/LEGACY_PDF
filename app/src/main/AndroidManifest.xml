<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.litepdf.reader">

    <!-- Storage permissions for reading PDF files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:largeHeap="true">

        <!-- Home Screen: Recent Files + All PDFs -->
        <activity
            android:name=".activities.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PDF Viewer Screen -->
        <activity
            android:name=".activities.PdfViewerActivity"
            android:label="@string/title_viewer"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize">

            <!-- Intent filter: open PDFs from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Folder Picker Screen -->
        <activity
            android:name=".activities.FolderPickerActivity"
            android:label="@string/title_folder_picker" />

        <!-- Settings Screen -->
        <activity
            android:name=".activities.SettingsActivity"
            android:label="@string/title_settings" />

    </application>

</manifest>
